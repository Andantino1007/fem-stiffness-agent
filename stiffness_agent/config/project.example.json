{
  "schema_version": 1,
  "project_id": "my-element-stiffness",
  "element_type": "MY_ELEMENT",
  "matrix_dimensions": [8, 8],
  "node_count": 4,
  "dof_labels_per_node": ["u", "v"],
  "diagnostic_groups": {
    "translation": ["u", "v"]
  },
  "dataset": "data/datasets/my_element.json",
  "primary_sample": "data/my_element/metadata/train_001.json",
  "reference_generation_methods": ["external_solver"],
  "adapter": {
    "kind": "command",
    "build_command": ["cmake", "--build", "build"],
    "evaluate_command": ["build/my_element_cli", "{sample}"],
    "test_command": ["ctest", "--test-dir", "build", "--output-on-failure"]
  },
  "agent": {
    "allowed_patch_paths": ["src/my_element.cpp"],
    "test_paths": ["tests/my_element_tests.cpp"],
    "experiment_classes": ["formulation", "integration", "dof_mapping"]
  },
  "acceptance": {
    "target_error": 0.01,
    "min_frobenius_absolute_drop": 1e-06,
    "min_frobenius_relative_drop": 0.0001,
    "max_symmetry_error": 1e-12,
    "max_absolute_error_regression": 0.01,
    "max_non_target_block_regression": 0.05,
    "max_validation_error_regression": 0.0
  }
}
